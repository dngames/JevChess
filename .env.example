# Where the TypeSafe API key can live. Both are optional: with no key at all the server
# plays "mock Jev", clearly labelled in the UI, so the app is fully usable for free.

# ---------------------------------------------------------------- option 1: .env
# Copy this file to .env and fill it in. .env is gitignored, but it is still plaintext.
# TYPESAFE_API_KEY=

# ------------------------------------------------- option 2: Windows secure storage
# Better on a shared or backed-up machine: the key is encrypted with DPAPI for your
# Windows user only and stored outside the repository in
# %LOCALAPPDATA%\JevChess\jev-key.dpapi
#
#   npm run key:set        # hidden prompt, then restart the server
#   npm run key:status     # confirm what is stored (never prints the key)
#   npm run key:clear
#
# The environment/.env always takes precedence over the stored key.

# Optional overrides
# TYPESAFE_MODEL=jev-latest     # or pin a version such as jev-1.13.0
# PORT=8787
# HOST=127.0.0.1
# JEV_MOCK=1                    # force the deterministic mock even when a key is set
