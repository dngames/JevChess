# Copy to .env and fill in your key. .env is gitignored.
#
# Get a key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Optional overrides
# TYPESAFE_MODEL=jev-latest     # or pin a version such as jev-1.13.0
# PORT=8787
# HOST=127.0.0.1
# JEV_MOCK=1                    # force the deterministic mock even when a key is set
